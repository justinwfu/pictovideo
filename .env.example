# Anthropic API key for Claude Haiku 4.5 vision
ANTHROPIC_API_KEY=

# Path to the youtube-pp-cli binary.
# Default is "youtube-pp-cli" (must be on $PATH).
# Uncomment and adjust if you keep it elsewhere:
# YOUTUBE_PP_CLI=/Users/you/printing-press/library/youtube/youtube-pp-cli

# YOUTUBE_API_KEY is read by youtube-pp-cli itself.
# Either:
#   (a) export it in your shell (~/.bash_profile or ~/.zshrc), OR
#   (b) run `youtube-pp-cli auth set-token <key>` once.
# Setting it in this .env file alone is NOT enough — the CLI checks the
# environment of the process that invokes it.
